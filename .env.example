# このファイルを .env という名前でコピーして編集します（copy .env.example .env）。
# 書かなかった項目は docker-compose.yml の既定値になります。

# 画面のポート番号（スマホからは http://<PCのIPアドレス>:8000 で開く）
WEB_PORT=8000

# Windows に直接インストールした Ollama の場所
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 使うモデル。VRAM 8GB（RX 7600）なら gemma4:e4b は GPU に全部載って速い。
OLLAMA_MODEL=gemma4:e4b
# 役割ごとに変えたいときだけ指定（空なら OLLAMA_MODEL）。
# 例: 作問だけ大きいモデルにする（VRAM に入りきらない分は CPU で動くので遅くなる）
#GEN_MODEL=gemma4:12b
#SOLVE_MODEL=
#REVIEW_MODEL=

# コンテキスト長と 1 回の最大出力トークン数（thinking の分も含む）
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=6144
# 使い終わったモデルを VRAM から降ろすまでの時間
OLLAMA_KEEP_ALIVE=15m
# 空ならモデルの既定（gemma4 は thinking あり）。gemma4 で false にすると JSON 出力が崩れる不具合があるので注意
OLLAMA_THINK=
# 1 回の LLM 呼び出しの待ち時間の上限（秒）
LLM_TIMEOUT=900

# 検証に落ちたときに作り直す回数
MAX_ATTEMPTS=4
# 審査役の LLM チェック（true / false）
REVIEW_ENABLED=true

# 在庫：最近使った単元・難易度ごとに何問作り置きするか
POOL_TARGET=2
# 在庫の自動補充（false にすると画面から依頼したときだけ作る）
REFILL_ENABLED=true
# 何日以内に使った単元を補充の対象にするか
REFILL_DAYS=14
