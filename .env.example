# このファイルを .env という名前でコピーして編集します:
#   cp .env.example .env
#   nano .env
# 書かなかった項目は docker-compose.yml の既定値になります。

# データの場所（NAS の HDD 上のフォルダ）。README の「データの場所を用意する」で作ったフォルダ
DATA_PATH=/srv/dev-disk-by-uuid-df337903-0195-4c8c-8237-49c1f271a27c/ai-quiz

# 画面のポート番号（スマホからは http://<PiのIPアドレス>:8000 で開く）
WEB_PORT=8000

# デスクトップPC（Windows）の Ollama の場所。192.168.x.x はデスクトップPCの固定IPに書き換える
OLLAMA_BASE_URL=http://192.168.x.x:11434

# 作成に使うモデルと、検証役のモデル・回数の初期値（「状態 → モデルと思考モード」でも変えられる。画面で選んだ方が優先。
# 依頼ごとに「作る」画面でも選べる）
GEN_MODEL=gemma4:12b-it-qat
VERIFY_MODEL=gemma4:e4b
VERIFY_COUNT=2
# 別系統のモデルにも 1 回解かせるときだけ書く（例: qwen2.5:7b）
VERIFY_MODEL_2=

# 問題検証モード（正解つきの問題の一覧・削除・書き出し）に入るときのパスワード。
# 空のままならパスワードなしで入れます。子供に見られたくなければ書いてください（ほかの画面にはかかりません）
REVIEW_PASSWORD=

# Anthropic（Claude）の API で作るとき（任意）。https://console.anthropic.com で作った API キーを書く。
# 空のままなら API は使わない（ローカル LLM だけ）。キーは他人に見せない
ANTHROPIC_API_KEY=
# API の利用額の上限（ドル）。「状態 → モデルと思考モード」の画面でも変えられる（画面の値が優先）
API_MONTHLY_LIMIT_USD=5
# 1 回の依頼の上限（ドル）。0 なら上限なし
API_JOB_LIMIT_USD=0
# 料金（ドル／100 万トークン、入力/出力）。値上げ・値下げがあったら直す
#ANTHROPIC_PRICES=claude-haiku-5-5=0.10/0.50,claude-sonnet-5-5=2/10,claude-opus-5-5=4/20
# 選べるモデル
#ANTHROPIC_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5
# 考える量（low / medium / high）。考えた分も出力の料金になる
#ANTHROPIC_EFFORT=low

# 1 問あたり何回まで作り直すか
MAX_ATTEMPTS=3
# Ollama につながらないとき、何秒ごとに再試行するか
OLLAMA_RETRY_SECONDS=60

# バックアップを何世代残すか・何時間ごとに取るか
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# 科目・端末ごとの未出題ストックがこれ未満なら「残りが少ない」と表示する
LOW_STOCK=40
# 解き始めのセットに混ぜる「間違えた問題」の上限（%）
RETRY_PERCENT=30

# 以下は通常は変えなくてよい
#OLLAMA_NUM_CTX=8192
# 1 回の出力の上限（トークン数。考えている分も含む）。/status の「最近の不合格」に
# 「出力の上限で途中で切れました」が多ければ増やす（num_ctx も一緒に増やす必要があります）
#OLLAMA_NUM_PREDICT=6144
#OLLAMA_KEEP_ALIVE=10m
# 思考モードは /status でモデルごとに選びます（自動：qwen3 系は切る、gemma4 はそのまま）。
# ここに true / false を書くと、「自動」のモデルはすべてその値になります
#OLLAMA_THINK=
#LLM_TIMEOUT=900
